# =============================================================================
# RUCHILOKA CAFÉ — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy into apps/web/.env.local (frontend) and apps/api/.env (backend) as needed.
# NEVER commit real .env files or paste secrets into NEXT_PUBLIC_* variables.
# =============================================================================

# --- Runtime Environment ---
NODE_ENV=development
APP_ENV=development

# --- Frontend (apps/web) Public Variables ---
# Must point to the deployed backend API origin in production (no trailing slash).
# Example (Dev): http://localhost:4000
# Example (Prod): https://ruchiloka-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Canonical frontend origin used for metadata, canonical links, and share links.
# Example (Dev): http://localhost:3000
# Example (Prod): https://ruchiloka.netlify.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Set to "true" ONLY in development to display non-production menu preview notice if DB is empty
NEXT_PUBLIC_SHOW_DEV_MENU_GUIDE=true

# --- Backend (apps/api) Core Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
# Comma-separated CORS allowlist (include Netlify deploy preview/prod domains in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL Database ---
# Managed PostgreSQL connection URL (Neon, Supabase, Render PostgreSQL, or local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruchiloka_dev?schema=public

# --- Session & Security Secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-character-cryptographically-random-secret
SESSION_TTL_DAYS=14
COOKIE_DOMAIN=

# --- Google OAuth 2.0 / OpenID Connect ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console -> Authorized redirect URIs
# Dev:  http://localhost:4000/api/v1/auth/google/callback
# Prod: https://<your-backend-domain>/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# --- Resend Transactional Emails ---
RESEND_API_KEY=
# Verified sender email on Resend (e.g. Ruchiloka Café <reservations@ruchilokacafe.com>)
RESEND_FROM_EMAIL=
# Comma-separated list of owner/staff recipient addresses for booking & enquiry alerts
ADMIN_NOTIFICATION_EMAIL=ruchiloka.in@gmail.com

# --- External Marketplace Ordering Integrations ---
# Feature flags must stay "false" until official partner/OAuth access is verified
ENABLE_SWIGGY_API_HANDOFF=false
ENABLE_ZOMATO_API_HANDOFF=false

# Verified Ruchiloka restaurant listing URLs & partner credentials (optional until live)
SWIGGY_RESTAURANT_ID=
SWIGGY_LISTING_URL=
SWIGGY_PARTNER_CLIENT_ID=
SWIGGY_PARTNER_CLIENT_SECRET=

ZOMATO_RESTAURANT_ID=
ZOMATO_LISTING_URL=
ZOMATO_PARTNER_API_KEY=

# --- Optional Media Storage (Cloudinary for Admin Menu Uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
